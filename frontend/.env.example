# Frontend environment variables — copy to .env.local
VITE_API_BASE_URL=http://localhost:8000

# Temporary password gate — remove once Entra ID is configured
# TODO: Delete once both VITE_ENTRA_CLIENT_ID and VITE_ENTRA_TENANT_ID are set
VITE_APP_PASSWORD=<shared-team-password>

# Microsoft Entra ID (uncomment when app registrations are ready)
# Entra mode is enabled only when BOTH of these are set.
# VITE_ENTRA_CLIENT_ID=<your-client-id>
# VITE_ENTRA_TENANT_ID=<your-tenant-id>
# VITE_ENTRA_REDIRECT_URI=http://localhost:5173
