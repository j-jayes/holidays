# ─────────────────────────────────────────────────
# Backend environment variables — copy to .env
# ─────────────────────────────────────────────────

# Azure Subscription
AZURE_SUBSCRIPTION_ID=<subscription-id>

# Azure Cosmos DB
COSMOS_DB_URL=https://<account>.documents.azure.com:443/
COSMOS_DB_KEY=<your-key>
COSMOS_DB_NAME=vacation-tracker

# Microsoft Entra ID (Azure AD)
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<client-id>
AZURE_CLIENT_SECRET=<client-secret>

# Email provider (Azure Communication Services or SendGrid)
EMAIL_PROVIDER=acs          # "acs" | "sendgrid"
ACS_CONNECTION_STRING=<acs-connection-string>
SENDGRID_API_KEY=<sendgrid-api-key>
EMAIL_FROM=noreply@yourcompany.com

# Public holiday API
PUBLIC_HOLIDAY_API_BASE=https://date.nager.at/api/v3

# App settings
APP_ENV=development         # "development" | "production"
FRONTEND_URL=http://localhost:5173
